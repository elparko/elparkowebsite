{
  "name": "github-pages-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pages": "node scripts/check-pages.mjs",
    "og": "node scripts/make-og.mjs",
    "predev": "npm run pages",
    "prebuild": "npm run pages",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test scripts/*.test.mjs",
    "export": "next build && next export",
    "deploy": "npm run export && touch out/.nojekyll",
    "embed": "node scripts/embed.mjs"
  },
  "dependencies": {
    "next": "14.2.7",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.7",
    "playwright-core": "^1.63.0"
  }
}
